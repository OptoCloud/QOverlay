@PACKAGE_INIT@

# FindOpenVR.cmake is installed alongside this file since OpenVR has no upstream
# CONFIG package - see the matching install(FILES ...) note in lib/CMakeLists.txt.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Qt6 COMPONENTS Gui OpenGL Qml Quick)
find_dependency(fmt CONFIG)
find_dependency(glm CONFIG)
find_dependency(OpenVR)

include("${CMAKE_CURRENT_LIST_DIR}/QOverlayLibTargets.cmake")
