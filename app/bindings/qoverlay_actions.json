      "/actions/main/in/GripValue": "Grip force (analog)",
      "/actions/main/in/Pointer": "Aim / pointing pose",
      "/actions/main/in/Thumbstick": "Move grabbed overlay closer / farther",
      "/actions/main/out/Haptic": "Haptic feedback"
    }
  ]
